{
  "version": 1,
  "variables": {
    "PORT": { "type": "port" },
    "API_BASE_URL": { "type": "url" },
    "NODE_ENV": { "type": "string", "enum": ["development", "test", "production"] },
    "ENABLE_CACHE": { "type": "boolean", "required": false },
    "API_KEY": { "type": "string", "minLength": 12, "required": false }
  }
}
